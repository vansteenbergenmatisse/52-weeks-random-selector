# Our 52 — API + worker image (shared). Runs via tsx.
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# Skip Chromium download; WhatsApp (optional) is disabled by default.
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN corepack enable

WORKDIR /app

# Install workspace deps (server only needs its own + root manifest).
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/server/package.json apps/server/package.json
RUN pnpm install --filter @our52/server... --prod=false

# App source
COPY apps/server ./apps/server
RUN pnpm --filter @our52/server exec prisma generate

WORKDIR /app/apps/server
EXPOSE 4000

# Default command runs the API; the worker service overrides it in compose.
CMD ["pnpm", "start"]
