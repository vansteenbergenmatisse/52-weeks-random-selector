# ── Our 52 environment ─────────────────────────────────────────────
# Copy to .env and adjust. The app runs fully without WhatsApp or TMDB.

# Node environment: development | production | test
NODE_ENV=development

# Enable the one-tap Teresa/Matisse space picker. This is a private shared space,
# so it's intentionally on in production too — but gate it with SPACE_PASSCODE
# below so a stranger who finds the URL can't tap straight in.
DEMO_MODE=true
# Shared secret that gates the one-tap picker on a public deploy. Leave empty for
# local dev (no gate). Set a value in production — both partners type it once.
SPACE_PASSCODE=
# Optional fixed password for the seeded Teresa/Matisse accounts. Leave empty and
# a strong random one is generated on first seed (never logged). The client never
# uses it — the picker signs in via the passcode-gated space-login endpoint.
DEMO_PASSWORD=

# ── Database (SQLite — a single local file, no separate DB service) ──
# Local dev: a file under apps/server/prisma/ (path is relative to the schema).
DATABASE_URL=file:./dev.db
# Production (e.g. Railway): put the file on a mounted Volume so it persists
# across redeploys — DATABASE_URL=file:/data/our52.db  (mount the Volume at /data).

# ── Server ─────────────────────────────────────────────────────────
PORT=4000
# Public base URL of the web app, used in WhatsApp deep links & invites.
APP_BASE_URL=http://localhost:5173
# Secret used to sign session cookies / tokens. Generate a long random string.
SESSION_SECRET=change-me-to-a-long-random-string-please
# Comma-separated allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173

# ── Scheduling defaults (per-collection overridable in the UI) ─────
DEFAULT_TIMEZONE=America/New_York
DEFAULT_WEEKDAY=0            # 0 = Sunday
DEFAULT_TIME=20:00          # 8:00 PM local
# How often the worker checks the schedule (seconds).
WORKER_TICK_SECONDS=30
# Run the scheduling worker inline in the API process (single-service SQLite
# deploy). Set false only if running a dedicated worker process.
RUN_WORKER=true

# ── TMDB (optional — manual movie entry works without it) ──────────
# Get a free developer key: https://developer.themoviedb.org/docs
TMDB_API_KEY=
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ── WhatsApp (optional — Baileys, unofficial, no browser) ──────────
# Enable the WhatsApp worker/adapter. When false, a fixture adapter is used.
WHATSAPP_ENABLED=false
# Where Baileys persists its multi-file auth session (must be durable). On
# Railway set this to a path on the mounted Volume, e.g. /data/whatsapp, so the
# paired session survives redeploys. (The container image already defaults it to
# /data/whatsapp.)
WHATSAPP_SESSION_DIR=./data/whatsapp

# ── Frontend (Vite) ────────────────────────────────────────────────
VITE_API_BASE=http://localhost:4000
