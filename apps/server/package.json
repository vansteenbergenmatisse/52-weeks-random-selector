{
  "name": "@our52/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/app/index.js",
  "scripts": {
    "dev": "tsx watch src/app/index.ts",
    "dev:worker": "tsx watch src/app/worker.ts",
    "build": "prisma generate && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/app/index.ts",
    "start:worker": "tsx src/app/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.1",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.6",
    "pino": "^9.13.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "1.26.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.16.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
